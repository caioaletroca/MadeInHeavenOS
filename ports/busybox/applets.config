# The applets and features busybox is built with, on top of `make allnoconfig`
# (everything off); `make oldconfig` then gives every option these bring in its
# default. A new applet is one line here. The build settings (compiler, sysroot,
# flags) are added by the Makefile.
#
# Left out for now: networking, mount, init and logins (ours or not needed),
# df (statfs), and anything needing mlibc's "linux" option.

# How busybox itself behaves
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y

# Line editing, for ash and vi
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=255
CONFIG_FEATURE_TAB_COMPLETION=y

# Files
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_LN=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_STAT=y
CONFIG_FIND=y

# Text
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_PRINTF=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_XARGS=y
CONFIG_OD=y
CONFIG_HEXDUMP=y
CONFIG_CMP=y

# Tools
CONFIG_MD5SUM=y
CONFIG_SHA256SUM=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_ENV=y
CONFIG_PWD=y
CONFIG_SLEEP=y
CONFIG_DATE=y
CONFIG_SEQ=y
CONFIG_YES=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_TEST=y

# Editor and pager
CONFIG_VI=y
CONFIG_LESS=y

# The shell: busybox's ash, run as "busybox sh" (/bin/sh stays ours)
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
